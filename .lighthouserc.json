{
  "ci": {
    "collect": {
      "staticDistDir": "./apps/docs/storybook-static",
      "url": ["/iframe.html?id=introduction--docs&viewMode=docs"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
