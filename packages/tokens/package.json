{
  "name": "@yashwanthvarma74/tokens",
  "version": "0.1.0",
  "description": "Design tokens for Meridian: colour, type, spacing, radius, shadow and motion.",
  "license": "MIT",
  "author": "Yashwanth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yashwanthvarma74-ai/designSystem.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://yashwanthvarma74-ai.github.io/designSystem/",
  "bugs": {
    "url": "https://github.com/yashwanthvarma74-ai/designSystem/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/tokens.js",
  "types": "./dist/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "contrast": "node scripts/check-contrast.mjs"
  },
  "devDependencies": {
    "style-dictionary": "^5.0.0"
  }
}
